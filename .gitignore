# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/coverage/
/.firebase/
/node_modules/
/functions/node_modules/
/functions/lib/
*-debug.log
/android/hs_err_pid*.log

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code local-only settings
.claude/settings.local.json

# Local screenshot capture intermediates
/temp/android-en-capture/
/play_store/assets/raw/phone/current.png
/play_store/assets/raw/phone/next.png

# Image generation working files (final sprites live under assets/images/).
/tmp/imagegen/

# Golden comparison artifacts are regenerated whenever a visual test fails.
/test/ui/failures/*_isolatedDiff.png
/test/ui/failures/*_maskedDiff.png
/test/ui/failures/*_masterImage.png
/test/ui/failures/*_testImage.png

# Production Firebase identity is generated by the release owner/CI. Emulator
# options are committed separately and contain no production credentials.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Android upload signing credentials are local-only and must never be committed.
/android/key.properties
/android/upload-keystore.jks
