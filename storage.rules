rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{objectId} {
      allow get: if request.auth != null && request.auth.uid == uid && objectId.matches('[A-Za-z0-9_-]+\\.(jpg|jpeg|webp)');
      allow write, list: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
