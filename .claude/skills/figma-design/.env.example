# Figma Design Skill — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .claude/skills/figma-design/.env.example .claude/skills/figma-design/.env
#
# The .env file is gitignored and will never be committed.

# Your Figma Personal Access Token
# Get it from: Figma → Account Settings → Security → Personal Access Tokens
# Required scopes: file:read (add variables:read for Figma Variables support)
FIGMA_TOKEN=figd_your_token_here

# Optional: default file key to avoid passing --file every time
# Extract from Figma URL: figma.com/design/<FILE_KEY>/...
FIGMA_FILE_KEY=
