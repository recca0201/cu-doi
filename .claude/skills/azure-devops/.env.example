# Azure DevOps Configuration Example
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials to version control

# Required
# Your Azure DevOps organization name (not the full URL)
# Example: "my-organization" for https://dev.azure.com/my-organization
AZURE_DEVOPS_ORG=your-org-name

# Personal Access Token (PAT) - Generate from Azure DevOps User Settings > Personal Access Tokens
# Required scopes: Work Items (Read, Write), Code (Read), Project and Team (Read)
# IMPORTANT: Keep this secret and never commit to git
AZURE_DEVOPS_PAT=your-personal-access-token

# Default project name (can be overridden in API calls)
AZURE_DEVOPS_PROJECT="Your Project Name"

# Optional: Default team name for capacity planning and iterations
# Format: Team name exactly as shown in Azure DevOps
AZURE_DEVOPS_TEAM=""

# Optional: Default area path for work items
# Format: Project\Area\SubArea (backslashes, no leading slash)
# Example: AZURE_DEVOPS_AREA_PATH="My Project\Backend\API"
AZURE_DEVOPS_AREA_PATH=""

# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Generate a PAT token:
#    - Go to Azure DevOps > User Settings > Personal Access Tokens
#    - Create new token with required scopes
#    - Copy the token (you won't see it again!)
# 3. Fill in your values in .env
# 4. Never commit .env to version control (.gitignore handles this)
